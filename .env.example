# ---- NextAuth (Google giriş) - redirect_uri_mismatch olursa NEXTAUTH_URL ve Google Console URI eşleşmeli ----
# Yerel: http://localhost:3000  (sonda / yok)
# Canlı: https://siteniz.com
NEXTAUTH_URL=
NEXTAUTH_SECRET=

# ---- Veritabanı (bu projede kullanılmıyor - Supabase/Prisma kaldırıldı) ----
# DATABASE_URL artık gerekmiyor

# ---- Bize Ulaşın formu - E-posta ----
CONTACT_EMAIL=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ---- Vercel Blob Storage (klasör yükleme scripti: npm run blob:upload -- <klasör> [prefix]) ----
# Vercel Dashboard > Storage > Blob Store oluştur, token'ı kopyala
# BLOB_READ_WRITE_TOKEN=

# ---- Cloudinary (görsel/dosya depolama, klasör yükleme: npm run cloudinary:upload -- <klasör> [prefix]) ----
# https://cloudinary.com Dashboard > Settings > API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Google Maps Embed - İletişim sayfası Konum haritası ----
# Google Cloud Console > APIs & Services > Enable "Maps Embed API" > Credentials > Create API key
GOOGLE_MAPS_EMBED_API_KEY=
# Opsiyonel: farklı konum için (varsayılan: 41.183954,28.719024)
CONTACT_MAP_QUERY=

