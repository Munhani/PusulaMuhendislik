# Google Maps Embed API - İletişim sayfası harita için
# https://console.cloud.google.com/apis/credentials
# API anahtarını "HTTP referrer" ile kısıtlayın (örn: https://pusulamuhendislik.com/*)
GOOGLE_MAPS_EMBED_API_KEY=

# Opsiyonel: Haritada kullanılacak arama sorgusu.
# En doğru sonuç için koordinat kullanın: "41.xxxxx,28.xxxxx"
CONTACT_MAP_QUERY=
